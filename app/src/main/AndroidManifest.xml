<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Permissions ──────────────────────────────────────────────────────── -->

    <!-- Fetch live breaking news for the blocked screen -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Draw the blocking overlay on top of other apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Keep a persistent foreground service running -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Restart services after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Fallback foreground-app detection -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Schedule exact alarm for service self-restart and weekly report -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Post weekly summary notifications (required on Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Query installed app labels and icons for the Manage Blocked Apps screen.
         Required on Android 11+ due to package visibility restrictions — without
         this, getApplicationInfo/getApplicationIcon throw NameNotFoundException
         for apps not explicitly listed in <queries>. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Required for JobScheduler setPersisted(true) -->
    <!-- (already covered by RECEIVE_BOOT_COMPLETED, listed here for clarity) -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BlockerOP">

        <!-- ── Main Activity ──────────────────────────────────────────────── -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.BlockerOP">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── Accessibility Service ──────────────────────────────────────── -->
        <!--
             This is the primary detection mechanism. It receives
             TYPE_WINDOW_STATE_CHANGED for every foreground app switch and
             triggers blocking immediately (zero polling delay).
        -->
        <service
            android:name=".service.BlockerAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- ── Foreground Service ─────────────────────────────────────────── -->
        <!--
             Keeps the process alive with a persistent notification.
             Uses FOREGROUND_SERVICE_TYPE_SPECIAL_USE (required on API 34+).
        -->
        <service
            android:name=".service.BlockerForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="app_blocker" />
        </service>

        <!-- ── Guard Job Service ──────────────────────────────────────────── -->
        <!--
             OS-managed periodic job that restarts the foreground service
             if it was killed. Minimum period: 15 minutes.
        -->
        <service
            android:name=".service.GuardJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- ── Boot Receiver ──────────────────────────────────────────────── -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- ── Weekly Report Receiver ─────────────────────────────────────── -->
        <receiver
            android:name=".receiver.WeeklyReportReceiver"
            android:exported="false" />

        <!-- ── Uninstall Ready Receiver ───────────────────────────────────── -->
        <receiver
            android:name=".receiver.UninstallReadyReceiver"
            android:exported="false" />

        <!-- ── Device Admin Receiver ──────────────────────────────────────── -->
        <!--
             Being an active Device Admin prevents the user from uninstalling
             BlockerOP via Settings > Apps. The only in-app exit path is the
             24-hour cooldown flow.
        -->
        <receiver
            android:name=".receiver.BlockerDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>


    </application>

</manifest>
